{
  "name": "@ruaibeite/dsh-undo",
  "version": "0.2.0",
  "description": "Turn-level file undo for DeepSeek Harness: every write and edit is snapshotted before it lands, and the model calls the undo tool to roll back all files a turn changed.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruaibeite/dsh-undo.git"
  },
  "homepage": "https://github.com/ruaibeite/dsh-undo#readme",
  "bugs": {
    "url": "https://github.com/ruaibeite/dsh-undo/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "undo",
    "rollback",
    "snapshot"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/roundtrip.mjs",
    "test:integration": "node test/cordis-integration.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || >=4.0.5-alpha.1 <4.0.6",
    "@deepseek-ai/dsh-fs": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.7-rc.1 <0.1.8-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.7-rc.1 <0.1.8-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-alpha.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1 || >=3.18.5-alpha.1 <3.18.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
